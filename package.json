{
  "name": "immobilier-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && prisma migrate deploy && tsx --env-file=.env scripts/seed-si-vide.ts && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:db": "dotenv -e .env -- sh -c 'DATABASE_URL=$DATABASE_URL_TEST prisma migrate deploy'",
    "test": "npm run test:db && vitest run --reporter verbose",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.1",
    "lucide-react": "^1.59.0",
    "next": "16.3.5",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
